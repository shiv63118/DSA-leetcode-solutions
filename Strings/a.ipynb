   "source": [
    "def checkPerfectNumber(num):\n",
    "    if num <= 1:\n",
    "        return False\n",
    "    total = 1\n",
    "    for i in range(2, int(num**0.5)+1):\n",
    "        if num % i == 0:\n",
    "            total += i + num //i\n",
    "    return num == total\n",
    "\n",
    "checkPerfectNumber(9)"
   ]
  }
 ],
